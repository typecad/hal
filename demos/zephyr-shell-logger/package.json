{
  "name": "zephyr-shell-logger",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "typecad-hal build",
    "compile": "typecad-hal build --compile",
    "upload": "typecad-hal build --compile --upload",
    "monitor": "typecad-hal build --compile --upload --monitor",
    "dev": "typecad-hal build --watch"
  },
  "dependencies": {
    "@typecad/cuttlefish": "*",
    "@typecad/hal": "*",
    "@typecad/framework-zephyr": "*"
  },
  "description": "STM32 Black Pill sentence shell \u2014 $CMD,field*checksum parser over USB CDC, file-backed settings, async boot via @typecad/framework-zephyr"
}
