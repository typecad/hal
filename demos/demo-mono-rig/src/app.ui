<script lang="ts">
  // app.ui — Stage 2 mono rig test (SSD1309 128x64, self-driving).
  //
  // Everything on screen animates from BINDINGS only (they re-evaluate every
  // ui_tick), so the panel shows motion with no wiring beyond power + I2C.
  // The WHOLE screen uses the built-in Classic bitmap family: native 5x7
  // pixels at 8px, and the Technoblogy smooth-doubled 16px for the hero
  // uptime reading (connected 45° diagonals, integer stems).
  //
  //   ┌────────────────────┐  What to verify visually:
  //   │ SSD1309 · MONO RIG │  1. Native 8px Classic cells, crisp by design
  //   │ t=12.5s            │  2. Smoothed Classic 16px digits (no staircases)
  //   │ ▓▓▓▓▓▓░░░░░░  47%  │  3. Bar sweeps 0→100% every 5s
  //   │ ██ INVERT ██       │  4. Button face inverts every second
  //   │ alternating line   │  5. Second line alternates text
  //   └────────────────────┘
  //
  // If the display shows transposed snow instead of this layout, the vtiled
  // MONO01 packing regressed. If nothing shows: wiring/address (scope the
  // build's TC_DISPLAY lines on the console).

  import { ui } from '@typecad/ui';
  import { Time } from '@typecad/hal';

  ui.mount(screen);

  // Seconds since boot, one decimal.
  ui.bind(screen.uptime, 'text', () => `t=${Math.floor(Time.now() / 100) / 10}s`);
  // Progress sweeps 0..99 every 5 seconds.
  ui.bind(screen.sweep, 'value', () => Math.floor(Time.now() / 50) % 100);
  // Read the bound node's own int value for the text renderings — node state
  // is int-typed, so `%`/ternaries stay integer C++.
  ui.bind(screen.sweepPct, 'text', () => `${screen.sweep.value}%`);
  // 1 Hz square wave drives the button's :pressed value → face inversion.
  ui.bind(screen.invert, 'value', () => Math.floor(Time.now() / 1000) % 2);
  // Alternating status line keyed off the same square wave.
  ui.bind(screen.alt, 'text', () => screen.invert.value ? 'colors: 0/1 only' : 'frame: full redraw');
</script>

<style>
  :root {
    background: #000000;
    color: #ffffff;
    flex-direction: column;
  }

  /* No @font-face: "Classic" is the built-in glcdfont 5x7 bitmap family —
     8px is the native cell, 16px the smooth doubling. */

  #titlebar {
    background: #ffffff;
    padding: 1px 3px;
    height: 10px;
  }
  #title {
    color: #000000;
    font-family: "Classic";
    font-size: 8px;
  }

  #row2 {
    padding: 0 3px;
    height: 17px;
  }
  #uptime {
    font-family: "Classic";
    font-size: 16px;
  }

  #row3 {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 3px;
    height: 12px;
  }
  #sweep {
    width: 90px;
    height: 10px;
    min-height: 0;
    border: 1px solid #ffffff;
  }
  #sweepPct {
    font-family: "Classic";
    font-size: 8px;
    width: 30px;
  }

  #row4 {
    display: flex;
    flex-direction: row;
    justify-content: center;
    padding: 1px 3px;
    height: 14px;
  }
  #invert {
    font-family: "Classic";
    font-size: 8px;
    width: 90px;
    min-height: 0;
    height: 12px;
    padding: 0 4px;
    border: 1px solid #ffffff;
    color: #ffffff;
  }
  #invert:pressed {
    background: #ffffff;
    color: #000000;
  }

  #row5 {
    padding: 1px 3px;
    height: 11px;
  }
  #alt {
    font-family: "Classic";
    font-size: 8px;
  }
</style>

<screen>
  <view id="titlebar">
    <text id="title">SSD1309 · MONO RIG</text>
  </view>
  <view id="row2">
    <text id="uptime">t=0s</text>
  </view>
  <view id="row3">
    <progress id="sweep" value="0"></progress>
    <text id="sweepPct">0%</text>
  </view>
  <view id="row4">
    <button id="invert">INVERT</button>
  </view>
  <view id="row5">
    <text id="alt">frame: full redraw</text>
  </view>
</screen>
