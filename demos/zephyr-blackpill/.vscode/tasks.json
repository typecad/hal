{
  "tasks": [
    {
      "label": "cuttlefish: build + flash (debug)",
      "type": "shell",
      "command": "npx cuttlefish build --compile --upload --debug",
      "options": {
        "cwd": "${workspaceFolder}/src/out"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "cuttlefish: debug server (west)",
      "type": "shell",
      "command": "npx cuttlefish debug-server start --flash",
      "options": {
        "cwd": "${workspaceFolder}/src/out",
        "env": {
          "NO_COLOR": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cuttlefish-debug-server",
        "pattern": {
          "regexp": "__cuttlefish_never_matches__"
        },
        "background": {
          "beginsPattern": "Transpiling",
          "endsPattern": "^CUTTLEFISH: debug server ready on 3333"
        }
      }
    },
    {
      "label": "cuttlefish: stop debug server",
      "type": "shell",
      "command": "npx cuttlefish debug-server stop",
      "options": {
        "cwd": "${workspaceFolder}/src/out"
      },
      "problemMatcher": []
    }
  ]
}
