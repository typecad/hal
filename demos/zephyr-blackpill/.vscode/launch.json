{
  "configurations": [
    {
      "name": "TypeCAD Debug (Zephyr, blackpill_f401cc)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/src/out/build/zephyr/zephyr.elf",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "gdbPath": "C:/Users/justi/micromamba/zephyr-sdk/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
      "postAttachCommands": [
        "set directories .",
        "set remote hardware-watchpoint-limit 2",
        "set remote hardware-breakpoint-limit 2",
        "monitor reset init",
        "thb main"
      ],
      "preLaunchTask": "typecad-hal: debug server (west)",
      "postDebugTask": "typecad-hal: stop debug server"
    }
  ]
}
