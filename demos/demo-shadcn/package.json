{
  "name": "demo-shadcn",
  "version": "1.0.0",
  "private": true,
  "description": "shadcn component-kit gallery \u2014 every recipe from `typecad-hal add shadcn` on one device",
  "type": "module",
  "scripts": {
    "build": "typecad-hal build",
    "compile": "typecad-hal build --compile",
