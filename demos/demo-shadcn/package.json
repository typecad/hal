    "lint": "eslint src/"
  },
  "dependencies": {
    "@typecad/ui": "*",
    "@typecad/zephyr-esp32s3-rgb": "*"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0"
  }
}
