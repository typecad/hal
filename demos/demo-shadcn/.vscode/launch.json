{
  "configurations": [
    {
      "name": "TypeCAD Debug (Zephyr, esp32s3_devkitc)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/src/build/zephyr/zephyr.elf",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "gdbPath": "C:/Users/justi/micromamba/zephyr-sdk/zephyr-sdk-1.0.1/gnu/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gdb.exe",
      "postAttachCommands": [
        "set directories .",
        "set remote hardware-watchpoint-limit 2",
        "set remote hardware-breakpoint-limit 2",
        "set mem inaccessible-by-default off",
        "mem 0x42000000 0x44000000 ro cache",
        "monitor reset init",
        "thb main",
        "c"
      ],
      "preLaunchTask": "typecad-hal: debug server (west)",
      "postDebugTask": "typecad-hal: stop debug server"
    }
  ]
}
