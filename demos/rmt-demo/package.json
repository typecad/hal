{
  "name": "rmt-demo",
  "version": "1.0.0",
  "private": true,
  "description": "RMT peripheral demo: ESP32-S3 onboard WS2812 RGB LED",
  "type": "module",
  "scripts": {
    "build": "cuttlefish build",
    "compile": "cuttlefish build --compile",
    "upload": "cuttlefish build --compile --upload --monitor",
    "transpile": "cuttlefish build --no-transpile",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@typecad/framework-arduino": "*",
    "@typecad/board-esp32s3": "*",
    "@typecad/mcu-esp32s3": "*"
  }
}
