  // adapter verification. Static scene exercises every draw primitive
  // (fill, rect, line, circle, text) so a single visual check proves the
  // full GFX path:
  //   ui_display_* shim → display_target* → CuttlefishGFX → spi_master
  //
  // No touch, no scroll, no canvas compositing — those paths get unit-test
  // coverage. This scene is small enough that pass/fail is visually obvious
  // on the panel in a few seconds.

  import { ui } from '@typecad/ui';

  ui.mount(screen);
</script>

