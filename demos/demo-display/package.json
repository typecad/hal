{
  "name": "demo-display",
  "version": "1.0.0",
  "private": true,
  "description": "ESP32-S3 + ST7796S display-only demo exercising the native ESP32 display adapter (no Adafruit, no Arduino-ESP32 core). Touch disabled — native touch shim port is deferred.",
  "type": "module",
  "scripts": {
    "build": "cuttlefish build",
    "compile": "cuttlefish build --compile",
    "upload": "cuttlefish build --compile --upload --port COM6",
    "preview": "cuttlefish preview --config ./cuttlefish.config.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@typecad/framework-esp32": "*",
    "@typecad/board-esp32s3": "*",
    "@typecad/mcu-esp32s3": "*",
    "@typecad/ui": "*"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0"
  }
}
