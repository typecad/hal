<script lang="ts">
  // showcase.ui — cuttlefish UI capability showcase (single-file component).
  // Combines script, styles, and template in one file. The transpiler splits
  // these into the three streams (TS/CSS/HTML) it already handles.

  import { ui } from '@typecad/ui';

  ui.mount(screen);

  // ── Forms screen: Svelte-like reactive state ───────────────────────────────
  // The button and input callbacks are declared here, while the template owns
  // the event attributes and interpolation sites. The rest of the form controls
  // use their element state directly through ui.bind() so every input has a
  // visible reactive effect.
  export const count = ui.signal(0);
  export const nameCommits = ui.signal(0);
  export const ageCommits = ui.signal(0);

  export function incrementTaps() {
    count.set(count() + 1);
  }

  export function captureName() {
    nameCommits.set(nameCommits() + 1);
    console.log('name:', screen.formName.text);
  }

  export function captureAge() {
    ageCommits.set(ageCommits() + 1);
    console.log('age:', screen.formAge.text);
  }

  ui.bind(screen.featureStatus, 'text', () => screen.formCheck1.value ? 'feature: enabled' : 'feature: disabled');
  ui.bind(screen.featureLamp, 'background', () => screen.formCheck1.value ? '#cccccc' : '#555555');
  ui.bind(screen.modeStatus, 'text', () => screen.formSelect1.value == 0 ? 'mode: alpha' : screen.formSelect1.value == 1 ? 'mode: beta' : 'mode: gamma');
  ui.bind(screen.modeAccent, 'background', () => screen.formSelect1.value == 0 ? '#aaaaaa' : screen.formSelect1.value == 1 ? '#dddddd' : '#666666');
  ui.bind(screen.radioStatus, 'text', () => screen.formRadio2.value ? 'speed: fast' : 'speed: calm');
  ui.bind(screen.volumeStatus, 'text', () => `volume: ${screen.formRange1.value}`);
  ui.bind(screen.formProg, 'value', () => screen.formRange1.value * 10);
  ui.bind(screen.formProgressCaption, 'text', () => `meter: ${screen.formRange1.value * 10}%`);

  // ── Lists screen: virtualized list ─────────────────────────────────────────
  ui.bindList(
    screen.demoList,
    () => 40,
    (i: number) => `Item ${i + 1}`,
    (i: number) => { console.log('tapped:', i); },
  );

  // ── Media screen: canvas drawing every primitive once ─────────────────────
  ui.drawCanvas(screen.demoCanvas, (ctx) => {
    ctx.fillScreen('#1a1a1a');
    ctx.fillRect(8, 8, 40, 24, '#333333');
    ctx.rect(8, 8, 40, 24, '#888888');
    ctx.fillRoundRect(56, 8, 40, 24, 6, '#444444');
    ctx.roundRect(56, 8, 40, 24, 6, '#aaaaaa');
    ctx.fillCircle(120, 20, 14, '#333333');
    ctx.circle(120, 20, 14, '#cccccc');
    ctx.line(150, 6, 190, 40, '#ffffff');
    ctx.hline(8, 48, 180, '#555555');
    ctx.vline(196, 8, 40, '#555555');
    ctx.drawPixel(10, 70, '#ffffff');
    ctx.drawPixel(14, 72, '#ffffff');
    ctx.drawPixel(18, 70, '#ffffff');
    ctx.drawPixel(22, 74, '#ffffff');
    ctx.drawPixel(26, 70, '#ffffff');
    ctx.text(8, 100, 'canvas primitives', '#cccccc');
  });

  // ── Keyboard screen: input opens the custom keyboard ───────────────────────
  screen.kbInput.onChange(() => {
    console.log('message:', screen.kbInput.text);
  });
</script>

<style>

@font-face {
