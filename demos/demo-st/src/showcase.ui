        <h1 class="demoH1">H1 heading</h1>
        <h2 class="demoH2">H2 heading</h2>
        <h3 class="demoH3">H3 heading</h3>
        <h4 class="demoH4">H4 heading</h4>
        <h5 class="demoH5">H5 heading</h5>
        <h6 class="demoH6">H6 heading</h6>
      </section>
      <section id="typeStyle">
        <p class="tBold">bold weight</p>
        <p class="tItalic" style="font-style: italic">italic style</p>
        <p class="tUnderline" style="text-decoration: underline">underline</p>
        <p class="tUpper" style="text-transform: uppercase">lowercase source</p>
        <p class="tCenter" style="text-align: center">centered text</p>
        <p class="tShadow" style="text-shadow: 1px 1px 1px rgba(255,255,255,0.6)">drop shadow</p>
        <p class="tShorthand" style="font: bold 18px 'ColibriDemo'; background-color: #888888; color: #000000">font shorthand</p>
        <p class="tEllipsis" style="text-overflow: ellipsis; white-space: nowrap; width: 120px; overflow: hidden">ellipsis shows trailing dots here</p>
        <p class="tClip" style="text-overflow: clip; white-space: nowrap; width: 120px; overflow: hidden">clip cuts the overflowed text</p>
      </section>
      <section id="typeSpacing">
        <p class="tLeading" style="line-height: 22px; width: 200px">Tall leading wraps a longer sentence across two lines.</p>
        <p class="tTracking" style="letter-spacing: 3px">wide tracking</p>
      </section>
      <section id="typeWrap">
        <p class="tNowrap" style="white-space: nowrap; width: 120px; overflow: hidden">nowrap clips the overflow</p>
        <p class="tPreLine" style="white-space: pre-line; width: 160px">hard break via &lt;br/&gt;<br/>then wraps naturally</p>
      </section>
      <section id="typeFont">
        <p class="tCustom" style="font-family: 'ColibriDemo'; font-size: 22px; font-weight: bold">custom font</p>
        <p class="tSmooth" style="font-smoothing: antialiased; font-size: 20px">antialiased</p>
        <p class="tBitmap" style="font-smoothing: none; font-size: 20px">bitmap</p>
      </section>
      <article id="typeArticle">
        <span class="tAside">&lt;article&gt; block alias</span>
      </article>
      <aside id="typeAside">
        <span class="tAside">&lt;aside&gt; block alias</span>
      </aside>
      <view id="typeView">
        <span class="tAside">&lt;view&gt; native container</span>
      </view>
    </main>
  </body>
</screen>

<!-- ── Rich Text (inline flow) ──────────────────────────────────────────── -->
<screen id="richtext">
  <body>
    <header class="screenHeader">
      <a class="backLink" href="#home">&lt; Back</a>
      <h2 class="screenTitle">Rich Text</h2>
    </header>
    <main class="scrollBody">
      <section id="richMixed">
        <!-- Mixed inline content flows on shared wrapped lines with per-run
             style: bold, italic, underline, color, and a tappable link. -->
        <p style="padding:8px; width:200px; font-smoothing: antialiased">This is a <b>rich text</b> paragraph with <i>italic</i>, <u>underline</u>, and a <a href="#home">link home</a>. It wraps across lines with <span style="color:#cccccc">colored</span> runs and a <span style="font-size:22px">bigger</span> word on the same line.</p>
      </section>
      <section id="richBreak">
        <p style="padding:8px; width:200px; font-smoothing: antialiased">Line one.<br/>Line two after a hard break.<br/><br/>After a blank line.</p>
      </section>
      <section id="richNested">
        <p style="padding:8px; width:200px; font-smoothing: antialiased">Nested <b>bold and <i>both</i></b> styles in one run sequence.</p>
      </section>
    </main>
  </body>
</screen>

