}

/* ── Color tokens (grayscale dark) ── */
:root {
  --background: #1f1f1f;
  --foreground: #e8e8e8;
  --card: #292929;
  --card-foreground: #e8e8e8;
  --primary: #f5f5f5;
  --primary-foreground: #242424;
  --secondary: #888888;
  --secondary-foreground: #1f1f1f;
  --muted: #424242;
  --muted-foreground: #b3b3b3;
  --accent: #b0b0b0;
  --accent-foreground: #1f1f1f;
  --destructive: #707070;
  --destructive-foreground: #f5f5f5;
  --border: #484848;
  --input: #383838;
  --ring: #909090;
  --chart-1: #909090;
  --chart-2: #aaaaaa;
  --chart-3: #888888;
  --chart-4: #999999;
  --chart-5: #777777;
  --radius: 0px;
  --shadow: 2px 2px 0 #000000;
}

@font-face {
  font-family: "ColibriDemo";
  src: url("DejaVuSans.ttf");
  font-weight: 400;
  font-style: normal;
}

@font-face {
  font-family: "ColibriDemo";
  src: url("DejaVuSans-Bold.ttf");
  font-weight: 700;
  font-style: normal;
}

@font-face {
  font-family: "ColibriDemo";
  src: url("DejaVuSans-Oblique.ttf");
  font-weight: 400;
  font-style: italic;
}

@font-face {
  font-family: "ColibriDemo";
  src: url("DejaVuSans-Oblique.ttf");
  font-weight: 300;
  font-style: italic;
}

@font-face {
  font-family: "ColibriDemo";
  src: url("DejaVuSans-ExtraLight.ttf");
  font-weight: 300;
  font-style: normal;
}





/* ── Shared screen scaffolding ── */
screen {
  background: var(--background);
  gap: 8px;
  padding: 10px;
}

/* Scrollable main column (UA gives body display:flex column flex:1). */
.scrollBody {
  overflow: scroll;
  flex: 1;
  align-items: center;
  gap: 10px;
  background: var(--background);
}

/* Shared content-screen header: Back link + title. */
.screenHeader {
  flex-direction: row;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  padding: 8px 10px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.backLink {
  font-size: 16px;
}
.screenTitle {
  color: var(--foreground);
  font-family: "ColibriDemo";
  font-size: 20px;
  font-weight: bold;
}

/* Shared section caption (used across showcase screens). Non-bold: the UA
   stylesheet makes h3 bold, but the runtime bumps textSize for bold text
   (roughly doubling per-char advance), which would wrap multi-word captions
   like "width / height / min / max" to 3 lines and overlap the next element.
   Normal weight keeps them on one line. */
.demoLabel {
  color: var(--muted-foreground);
  font-size: 14px;
  font-weight: normal;
}
.demoCap {
  color: var(--muted-foreground);
  font-size: 13px;
}

/* ── Home ── */
#homeHeader {
  flex-direction: column;
  align-items: center;
  /* <body> is a flex column with no align-items, so a fixed-width child would
     sit at the left edge. Center the header horizontally in the screen to
     match how .scrollBody centers its children (#homeNav, etc.). */
  align-self: center;
  gap: 2px;
  width: 280px;
  border: 1px solid var(--border);
  background: var(--card);
  padding: 8px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
#homeTitle {
  color: var(--foreground);
  font-family: "ColibriDemo";
  font-size: 24px;
  font-weight: bold;
  text-align: center;
}
#homeSubtitle {
  color: var(--muted-foreground);
  font-size: 14px;
  text-align: center;
}
#homeNav {
  align-items: stretch;
  gap: 6px;
