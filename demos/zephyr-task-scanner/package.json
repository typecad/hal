{
  "name": "zephyr-task-scanner",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "typecad-hal build",
    "compile": "typecad-hal build --compile",
    "upload": "typecad-hal build --compile --upload",
    "monitor": "typecad-hal build --compile --upload --monitor",
    "dev": "typecad-hal build --watch"
  },
  "dependencies": {
    "@typecad/cuttlefish": "*",
    "@typecad/hal": "*",
    "@typecad/framework-zephyr": "*"
  },
  "description": "STM32 Black Pill task scanner — priority task scanning with break/continue/do-while control flow and a Set-based run ledger via @typecad/framework-zephyr"
}
