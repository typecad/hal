{
  "name": "demo-console-app",
  "version": "1.0.0",
  "private": true,
  "description": "ESP32 demo using the TypeCAD transpiler with native ESP-IDF lowering",
  "type": "module",
  "scripts": {
    "build": "cuttlefish build",
    "compile": "cuttlefish build --compile",
    "upload": "cuttlefish build --compile --upload --port COM6 --monitor",
    "transpile": "cuttlefish build --no-transpile",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@typecad/framework-esp32": "*",
    "@typecad/board-esp32-devkit": "*",
    "@typecad/mcu-esp32": "*"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0"
  }
}
