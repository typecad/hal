{
  "name": "demo-console-app",
  "version": "1.0.0",
  "private": true,
  "description": "ESP32-S3 demo showcasing @typecad/safety's safe.read — verified GPIO reads + fault surfacing",
  "type": "module",
  "scripts": {
    "build": "cuttlefish build",
    "compile": "cuttlefish build --compile",
    "upload": "cuttlefish build --compile --upload",
    "transpile": "cuttlefish build --no-transpile",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@typecad/framework-esp32": "*",
    "@typecad/board-esp32s3": "*",
    "@typecad/mcu-esp32s3": "*",
    "@typecad/safety": "*"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0"
  }
}
