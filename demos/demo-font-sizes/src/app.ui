<script lang="ts">
  // app.ui — the font-size ladder (SSD1309 128x64, static specimen).
  //
  // Every row is the SAME face through the standard mono pipeline (hinted
  // stems, corner bridging, blue zones, kerning) at a different size — the
  // size prefixed in its own sample so the scale reads directly on panel:
  //
  //   ┌────────────────────┐
  //   │ 10 Ag Rg 47%       │  10px — the candidate floor (MONO-SPACED)
  //   │ 11 Ag Rg 47%       │  11px — one notch up, is it the floor?
  //   │ 13 Ag Rg 47%       │  13px — the known-good workhorse
  //   └────────────────────┘
  //
  // Static on purpose: this is a specimen, not an animation. Flash, squint,
  // pick the floor you like for body text.
  import { ui } from '@typecad/ui';

  ui.mount(screen);
</script>

