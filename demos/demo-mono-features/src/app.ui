<script lang="ts">
  // app.ui — mono feature exercise (SSD1309 128x64, ESP32-S3).
  //
  // Closes the Stage 2 hardware-verification gaps in one flash: 1bpp images
  // (threshold + Floyd-Steinberg), a scrollable virtualized list, a select,
  // a toast, a dialog, GPIO input, and visibility-driven pages.
  //
  // Interaction — no touch panel: the BOOT button (GPIO0, active-low) is
  // watched via ui.watchPin. Each press flips between pages A/B; every 3rd
  // press pops a toast; every 5th opens the dialog (the next press closes
  // it). The two <screen> elements + href links compile the ui_navigate
  // path; activating those needs touch, so pages drive the live demo.
  //
  //   Page A: title bar, threshold image (logo.png), animated progress,
  //           press counter.
  //   Page B: title bar, FS-dithered gradient (grad.png), 30-item list
  //           (scrollbar drawn; drag-scroll needs a touch panel), select.

  import { ui } from '@typecad/ui';
  import { Time } from '@typecad/hal';

  ui.mount(screen);

  export const page = ui.signal(0);
  export const presses = ui.signal(0);
  export const dialogOpen = ui.signal(0);

  ui.watchPin(0, () => {
    if (dialogOpen()) {
      ui.dialog.close('featDialog');
      dialogOpen.set(0);
      return;
    }
    const n = presses() + 1;
    presses.set(n);
    page.set(page() === 0 ? 1 : 0);
    if (n % 3 === 0) ui.toast('featToast');
    if (n % 5 === 0) {
      ui.dialog.open('featDialog');
      dialogOpen.set(1);
    }
  });

  ui.bind(screen.pgA, 'visible', () => page() === 0);
  ui.bind(screen.pgB, 'visible', () => page() === 1);
  ui.bind(screen.barBTitle, 'text', () => `FEATURES 2/2  #${presses()}`);

  // Sweep 0..99 every 5s (int arithmetic — see the mono-rig notes).
  ui.bind(screen.featProgress, 'value', () => Math.floor(Time.now() / 50) % 100);

  // Readouts: the inputless-display idiom — live values, no interaction.
  ui.bind(screen.roSel, 'text', () => `t=${Math.floor(Time.now() / 100) / 10}s`);
  ui.bind(screen.ro1, 'text', () => `up ${Math.floor(Time.now() / 1000)}s`);
  // NOTE: % on Math.floor() doubles doesn't lower inside text bindings (the
// known engine gap) — the subtraction form of modulo is used instead.
  ui.bind(screen.ro2, 'text', () => `cyc ${Math.floor(Time.now() / 500) - Math.floor(Time.now() / 49500) * 99}`);
    ui.bind(screen.ro3, 'text', () => `rssi ${62 + Math.floor(Time.now() / 3000) - Math.floor(Time.now() / 15000) * 5}`);
</script>

<style>
  @font-face {
    font-family: "Feat";
    src: url("../../../packages/ui/assets/fonts/dejavu/DejaVuSansMono.ttf");
    font-weight: 400;
    font-style: normal;
  }

  :root {
    background: #000000;
    color: #ffffff;
    flex-direction: column;
  }

  view, text, button, select, progress {
    font-family: "Feat";
    font-size: 11px;
  }

  #pgA, #pgB {
    /* Overlay at the same origin — the visible binding picks the page. In
       flow layout the second page would stack at y64 (off-screen). */
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: column;
    width: 128px;
    height: 64px;
  }

  #barA, #barB {
    background: #ffffff;
    padding: 1px 3px;
    height: 13px;
  }
  #barA text, #barB text {
    color: #000000;
    /* Optical vertical centering: the 11px face's cell is 15px in a 13px
       bar and NODE_TEXT top-aligns, so the caps sat on the bar's bottom
       row. Shift up 3px — cap ink lands on rows 2-9 of 13. */
    margin-top: -3px;
  }

  #logoImg {
    margin: 2px 16px 0 16px;
  }

  #progRow {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 3px 3px 0 3px;
    height: 15px;
  }
  #featProgress {
    width: 90px;
    height: 9px;
    min-height: 0;
    border: 1px solid #ffffff;
  }

  #hintRow {
    padding: 1px 3px 0 3px;
    height: 13px;
  }
  #hintRow text {
    color: #909090;
  }

  #gradRow {
    display: flex;
    flex-direction: row;
    padding: 1px 3px;
    height: 24px;
  }
  #gradImg {
    margin: 2px 0 0 2px;
  }
  #roSel {
    margin: 4px 0 0 8px;
    height: 15px;
    white-space: nowrap;
  }

  #readouts {
    flex-direction: column;
    margin: 1px 3px 0 3px;
    height: 26px;
  }
  #readouts text {
    height: 8px;
  }

  #featToast {
    background: #ffffff;
    color: #000000;
  }

  #featDialog {
    background: #000000;
    border: 1px solid #ffffff;
  }
</style>

<screen id="features">
  <view id="pgA">
    <view id="barA"><text id="barATitle">FEATURES 1/2</text></view>
    <img id="logoImg" src="logo.png" dither="threshold"></img>
    <view id="progRow">
      <progress id="featProgress" value="0"></progress>
    </view>
      <view id="hintRow"><text id="hintA">BOOT: next page</text></view>
  </view>
  <view id="pgB" style="visible: hidden">
    <view id="barB"><text id="barBTitle">FEATURES 2/2</text></view>
    <view id="gradRow">
      <img id="gradImg" src="grad.png" dither="floyd-steinberg"></img>
      <text id="roSel">t=0s</text>
    </view>
    <view id="readouts">
      <text id="ro1">up 0s</text>
      <text id="ro2">cyc 0</text>
      <text id="ro3">rssi 62</text>
    </view>
  </view>
  <toast id="featToast" duration="2000">page flipped</toast>
  <dialog id="featDialog">
    <text id="dlgTitle">every 5th press</text>
    <text id="dlgBody">BOOT closes this</text>
  </dialog>
  <view id="pageEchoWrap" style="display: none"><text id="pageEcho">page: A</text></view>
</screen>
<screen id="nav">
  <view id="navBar" class="bar">
    <text id="navTitle">NAV (touch builds)</text>
  </view>
  <view id="navBody">
    <text id="navHint">href links auto-wire taps</text>
    <button id="navHome" href="#features">back to features</button>
  </view>
</screen>
