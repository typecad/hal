{
  "name": "typecode-native-demo",
  "version": "1.0.0",
  "description": "TypeCode native C++ demo — portable Windows/Linux executables",
  "private": true,
  "scripts": {
    "build": "cd .. && node packages/transpiler/dist/cli.js native_demo/src/main.ts --framework @typecode/framework-native",
    "build:watch": "cd .. && node packages/transpiler/dist/cli.js build --project native_demo",
    "native": "cd .. && node packages/transpiler/dist/cli.js native_demo/src/main.ts --compile --framework @typecode/framework-native",
    "ts": "npx tsx src/main.ts"
  },
  "dependencies": {
    "@typecode/core": "*",
    "@typecode/framework-native": "*",
    "@typecode/transpiler": "*"
  }
}
