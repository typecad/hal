{
  "name": "typecad-native-demo",
  "version": "1.0.0",
  "description": "TypeCAD native C++ demo — portable Windows/Linux executables",
  "private": true,
  "scripts": {
    "build": "cd .. && node packages/cuttlefish/dist/cli.js native_demo/src/main.ts --framework @typecad/framework-native",
    "build:watch": "cd .. && node packages/cuttlefish/dist/cli.js build --project native_demo",
    "native": "cd .. && node packages/cuttlefish/dist/cli.js native_demo/src/main.ts --compile --framework @typecad/framework-native",
    "ts": "npx tsx src/main.ts"
  },
  "dependencies": {
    "@typecad/hal": "*",
    "@typecad/framework-native": "*",
    "@typecad/cuttlefish": "*"
  }
}
