<script lang="ts">
  // showcase.ui — minimal "hello world" for SSD1309 OLED (128×64, 1-bit mono).
  import { ui } from '@typecad/ui';

  ui.mount(screen, {
    display: 'ssd1309',
    bus: 'I2C',
    address: 0x3C,
    reset: -1,
  });
</script>

