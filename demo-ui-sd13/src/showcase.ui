<script lang="ts">
  // showcase.ui — SSD1309 OLED capability showcase (128×64, 1-bit mono, no touch).
  // Single-screen layout exercising text sizes, alignment, shapes, borders,
  // and a reactive counter that auto-increments — all visible at once.
  import { ui } from '@typecad/ui';

  ui.mount(screen, {
    display: 'ssd1309',
    bus: 'I2C',
    address: 0x3C,
    reset: -1,
  });

  export const count = ui.signal(0);

  // Auto-increment the counter every second (no touch to tap a button).
  __tc_setInterval(() => {
    count.set(count() + 1);
  }, 1000);
</script>

