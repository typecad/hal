<script lang="ts">
  // showcase.ui — SSD1309 OLED capability showcase (128×64, 1-bit mono).
  // Exercises text sizes, alignment, shapes, borders, navigation, and
  // a reactive counter — all within a 128×64 monochrome canvas.
  import { ui } from '@typecad/ui';

  ui.mount(screen, {
    display: 'ssd1309',
    bus: 'I2C',
    address: 0x3C,
    reset: -1,
  });

  export const count = ui.signal(0);

  export function incrementCount() {
    count.set(count() + 1);
  }
</script>

