{
  "compilerOptions": {
    "target": "ES2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@typecode": ["../packages/board-arduino-uno/src/index.ts"],
      "@typecode/core": ["../packages/core/src/index.ts"],
      "@typecode/board-arduino-uno": ["../packages/board-arduino-uno/src/index.ts"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "typecode.config.ts"]
}
