{
  "name": "typecode-demo",
  "version": "1.0.0",
  "description": "TypeCode demo project for ESP32 DevKit",
  "private": true,
  "scripts": {
    "build": "typecode ./src/sketch.ts",
    "build:watch": "typecode build --watch",
    "compile": "typecode ./src/sketch.ts --compile",
    "upload": "typecode ./src/sketch.ts --compile --upload --port COM6",
    "debug": "typecode ./src/sketch.ts --compile --upload --debug --monitor --port COM6"
  },
  "dependencies": {
    "@typecode/core": "*",
    "@typecode/board-esp32-devkit": "*",
    "@typecode/framework-arduino": "*"
  }
}
