{
  "name": "typecode-demo-arduino-uno",
  "version": "1.0.0",
  "description": "TypeCode demo project for Arduino Uno",
  "private": true,
  "scripts": {
    "build": "node ../packages/cli/dist/cli.js ./src/sketch.ts",
    "build:watch": "node ../packages/cli/dist/cli.js build --watch",
    "compile": "node ../packages/cli/dist/cli.js ./src/sketch.ts --compile",
    "upload": "node ../packages/cli/dist/cli.js ./src/sketch.ts --compile --upload --port COM6",
    "debug": "node ../packages/cli/dist/cli.js ./src/sketch.ts --compile --upload --debug --monitor --port COM6",
    "test:hw": "node ../packages/cli/dist/cli.js --expect",
    "test:hw-01": "node ../packages/cli/dist/cli.js --expect ./src/07-classes.test.ts"
  },
  "dependencies": {
    "@typecode/core": "*",
    "@typecode/board-arduino-uno": "*",
    "@typecode/framework-avr": "*",
    "@typecode/framework-arduino": "*",
    "@typecode/expect": "*"
  }
}
