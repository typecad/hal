{
  "name": "typehal-demo",
  "version": "1.0.0",
  "description": "TypeHAL demo project for ESP32 DevKit",
  "private": true,
  "scripts": {
    "build": "cd .. && node packages/transpiler/dist/cli.js demo/src/sketch.ts",
    "build:watch": "cd .. && node packages/transpiler/dist/cli.js build --project demo",
    "compile": "cd .. && node packages/transpiler/dist/cli.js demo/src/sketch.ts --compile",
    "upload": "cd .. && node packages/transpiler/dist/cli.js demo/src/sketch.ts --compile --upload --port COM7",
    "debug": "cd .. && node packages/transpiler/dist/cli.js demo/src/sketch.ts --compile --upload --debug --monitor --port COM7"
  },
  "dependencies": {
    "@typehal/core": "*",
    "@typehal/board-esp32-devkit": "*",
    "@typehal/framework-arduino": "*"
  }
}
