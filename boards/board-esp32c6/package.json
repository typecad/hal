{
  "name": "@typecad/board-esp32c6",
  "version": "1.0.0-alpha.10",
  "description": "TypeCAD ESP32-C6 board definition with typed pins and peripherals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@typecad/cuttlefish": "1.0.0-alpha.10",
    "@typecad/hal": "1.0.0-alpha.10",
    "@typecad/mcu-esp32c6": "1.0.0-alpha.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "boards/board-esp32c6"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/boards/board-esp32c6",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "board",
    "cpp",
    "cuttlefish",
    "devkit",
    "embedded",
    "esp32c6",
    "firmware",
    "microcontroller",
    "pins",
    "typecad",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "typecad0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
