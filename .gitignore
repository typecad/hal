# Dependencies
node_modules/

# Lockfile — not tracked; CI installs from package.json (npm install)
package-lock.json

# Build output
dist/
**/.build/
src/build/
**/*.tsbuildinfo

# TypeScript project state
*.tsbuildinfo

# Logs & coverage
*.log
coverage/
.nyc_output/

# Env / secrets
.env
.env.*
!.env.example

# Generated/transient scratch files
tmp-*.txt
dbg.txt
rt.txt
glyphs.txt

# Local npm pack/install verification scratch (tarballs + scaffolded installs)
.npm-pack-test/

# Windows reserved-name redirect accidents
nul
**/nul

# Editor / OS — .vscode is local state except the bundled typecad-ui
# highlighting extension, which is shared so .ui files highlight for everyone.
.vscode/*
!.vscode/extensions/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Local debug/editor state (breakpoints, agent session plans)
.cuttlefish/
.typecode/
.zcode/

# Agent/editor instruction files (kept locally, not source of truth)
AGENTS.md
CLAUDE.md
.github/copilot-instructions.md

# Archives
*.zip

# website is a separate repo (was orphaned submodule gitlink)
website/

# brainstorming visual companion
.superpowers/

# Agent planning/research/spec artifacts (kept locally, not source of truth)
docs/superpowers/

# Generated demo config (per-project override)
examples/*/cuttlefish.config.js
vitest.config.js

# Historical demo snapshots (not source of truth)
examples/*/*-backup/

# VS Code extension build artifacts
*.vsix

# Vendored Arduino libraries under examples/*/lib/ are intentionally tracked
# so a fresh clone can flash to hardware without re-fetching.

# Demo projects live outside the npm workspace and are not published.
# Sources are tracked; only build output and local scratch are ignored.
# demos/wifi-demo/out-samples/ stays tracked as a regression corpus for the
# WiFi/HTTP lowering — future drift (stack sizes, shim shape, etc.) shows up
# as a diff against those files.
demos/*/src/out/
demos/*/src/out-*/
demos/*/src/build/
demos/*/src/src/
demos/*/out/
demos/*/build/
demos/*/cuttlefish.config.js
demos/*/.cuttlefish-cache.json

# Transpiler output from package-local hardware test runs
packages/*/tests/out/

# Toolchain cache with absolute local paths
**/.typehal-cache.json

# Large/unreferenced assets + demo-only eslint rules (kept locally, not published)
cuttlefish.png
cuttlefish.svg
eslint-transpiler-rules.mjs

# Generated WiFi credentials + server address for the HTTP hardware test.
# Produced by `npm run test:http` (tests/hardware/start-server.ts).
tests/hardware/secrets.ts
