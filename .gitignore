# Dependencies
node_modules/

# Lockfile — not tracked; CI installs from package.json (npm install)
package-lock.json

# Build output
dist/
**/.build/
src/build/
**/*.tsbuildinfo

# Generated '@typecad/test-pins' modules (written next to the importing file
# by the transpile-time resolver; see packages/cuttlefish/src/transpile/test-pins.ts)
**/test-pins.gen.ts

# TypeScript project state
*.tsbuildinfo

# Logs & coverage
*.log
coverage/
.nyc_output/

# Env / secrets
.env
.env.*
!.env.example

# Generated/transient scratch files
tmp-*.txt
dbg.txt
rt.txt
glyphs.txt

# Local npm pack/install verification scratch (tarballs + scaffolded installs)
.npm-pack-test/

# Windows reserved-name redirect accidents
nul
**/nul

# Editor / OS — .vscode is local state except the bundled typecad-ui
# highlighting extension, which is shared so .ui files highlight for everyone.
.vscode/*
!.vscode/extensions/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Local debug/editor state (breakpoints, agent session plans)
.cuttlefish/
.typecode/
.zcode/

# Agent/editor instruction files (kept locally, not source of truth)
AGENTS.md
CLAUDE.md
.github/copilot-instructions.md

# Archives
*.zip

# website is a separate repo (was orphaned submodule gitlink)
website/

# brainstorming visual companion
.superpowers/

# Agent planning/research/spec artifacts (kept locally, not source of truth)
docs/superpowers/

# Generated demo config (per-project override)
examples/*/cuttlefish.config.js
vitest.config.js

# Historical demo snapshots (not source of truth)
examples/*/*-backup/

# VS Code extension build artifacts
*.vsix

# Vendored Arduino libraries under examples/*/lib/ are intentionally tracked
# so a fresh clone can flash to hardware without re-fetching.

# Demo projects live outside the npm workspace and are not published.
# Sources are tracked; only build output and local scratch are ignored.
# demos/wifi-demo/out-samples/ stays tracked as a regression corpus for the
# WiFi/HTTP lowering — future drift (stack sizes, shim shape, etc.) shows up
# as a diff against those files.
demos/*/src/out/
demos/*/src/out-*/
demos/*/src/build/
demos/*/src/src/
demos/*/out/
demos/*/build/
demos/*/cuttlefish.config.js
demos/*/.cuttlefish-cache.json

# Transpiler output from package-local hardware test runs
packages/*/tests/out/

# Toolchain cache with absolute local paths
**/.typehal-cache.json

# Large/unreferenced assets + demo-only eslint rules (kept locally, not published)
cuttlefish.png
cuttlefish.svg
eslint-transpiler-rules.mjs

# Generated WiFi credentials + server address for the HTTP hardware test.
# Produced by `npm run test:http` (packages/hal/tests/network/start-server.ts).
packages/hal/tests/network/secrets.ts

# scratch probe build artifacts (local hardware debugging; the .probe/*.cpp
# sources and extracted headers are TRACKED — see commit 2f6bc29f)
.probe/*.exe
.probe/*.o

# Local agent/dev scratch (transient scaffolding + doc-check harness)
.tmp-narrow/
.doccheck/

# VS Code debug extension — kept locally only for now (untracked per decision);
# the vendored copy under packages/cuttlefish/assets/editor-extensions/typecad-debug/
# remains tracked and is what scaffolds install.
packages/vscode-typecad-debug/

# Local scaffold scratch dirs (cuttlefish create test output)
my-project/
tmp-scaffold/

# Generated project artifacts (board module, as-built snapshot) — regenerated
# per machine on build. Tracked copies under packages/hal/.typecad-hal/ stay
# tracked (ignore rules don't untrack).
.typecad-hal/

# hal network-test rig: transpiled/built diagnostic output (regenerated per
# run) + self-signed test certs — never tracked (the standalone hal repo
# matches this)
packages/hal/tests/network/ble-diag/src/CMakeLists.txt
packages/hal/tests/network/ble-diag/src/prj.conf
packages/hal/tests/network/ble-diag/src/boards/
packages/hal/tests/network/ble-diag/src/src/
packages/hal/tests/network/ble-diag/src/build/
packages/hal/tests/network/certs/
