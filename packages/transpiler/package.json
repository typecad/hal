{
  "name": "@typehal/transpiler",
  "version": "0.1.0",
  "description": "TypeHAL TypeScript to C++ transpiler for embedded development",
  "type": "commonjs",
  "main": "./dist/transpile.js",
  "types": "./dist/transpile.d.ts",
  "bin": {
    "typehal": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/transpile.d.ts",
      "default": "./dist/transpile.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.0",
    "@typehal/core": "*",
    "@typehal/schema": "*"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "optionalDependencies": {
    "@typehal/create": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  },
  "license": "MIT"
}