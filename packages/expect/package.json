{
  "name": "@typecode/expect",
  "version": "0.1.0",
  "description": "Hardware test framework for TypeCode — vitest-style assertions over serial",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typecode-test": "./dist/host/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preprocessor": {
      "types": "./dist/host/preprocessor.d.ts",
      "default": "./dist/host/preprocessor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "typescript": "^5.7.3",
    "@typecode/core": "^0.1.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
