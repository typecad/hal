{
  "name": "@typecode/simulator",
  "version": "0.1.0",
  "description": "Hardware simulation runtime for TypeCode — test HAL code in Node.js without hardware",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "typescript": "^5.7.3",
    "@typecode/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  },
  "license": "MIT"
}
