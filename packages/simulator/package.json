{
  "name": "@typecad/simulator",
  "version": "1.0.0-alpha.16",
  "description": "Hardware simulation runtime for TypeCAD — test HAL code in Node.js without hardware",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@typecad/hal": "1.0.0-alpha.16"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@typecad/cuttlefish": "1.0.0-alpha.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "packages/simulator"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/simulator",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "cpp",
    "cuttlefish",
    "desktop",
    "embedded",
    "emulator",
    "firmware",
    "microcontroller",
    "simulator",
    "typecad",
    "typescript"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "author": "typecad0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
