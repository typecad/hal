{
  "name": "@typecad/hal",
  "version": "1.0.0-alpha.14",
  "description": "TypeCAD hardware abstraction layer — GPIO, I2C, SPI, UART as regular TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "packages/hal"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/hal",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "cpp",
    "cuttlefish",
    "embedded",
    "firmware",
    "gpio",
    "hal",
    "hardware-abstraction",
    "i2c",
    "microcontroller",
    "spi",
    "typecad",
    "typescript",
    "uart"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "author": "typecad0",
  "devDependencies": {
    "@typecad/expect": "1.0.0-alpha.14"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
