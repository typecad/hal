{
  "name": "@typecad/ui",
  "version": "0.1.0-alpha.1",
  "description": "TypeCAD UI authoring library — HTML/CSS-driven graphics for microcontrollers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine-index.d.ts",
      "default": "./dist/engine-index.js"
    },
    "./runtime-header": {
      "types": "./dist/ui-engine/runtime-header.d.ts",
      "default": "./dist/ui-engine/runtime-header.js"
    },
    "./ui-engine/*": {
      "types": "./dist/ui-engine/*.d.ts",
      "default": "./dist/ui-engine/*.js"
    },
    "./preview/*": {
      "types": "./dist/preview/*.d.ts",
      "default": "./dist/preview/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@typecad/cuttlefish": "0.1.0-alpha.1"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "linkedom": "^0.18.12",
    "opentype.js": "^2.0.0",
    "yoga-layout": "^3.2.1"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/ui",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "embedded",
    "microcontroller",
    "esp32",
    "tft",
    "ili9341",
    "ui",
    "html",
    "css",
    "gui",
    "typecad",
    "cuttlefish",
    "typescript",
    "cpp",
    "firmware"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/opentype.js": "^1.3.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "typecad0"
}
