{
  "name": "@typecad/safety",
  "version": "1.0.0-alpha.12",
  "description": "TypeCAD safety mechanisms — verified GPIO reads, fault reporting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine-index.d.ts",
      "default": "./dist/engine-index.js"
    },
    "./safety-hook-types": {
      "types": "./dist/safety-hook.d.ts",
      "default": "./dist/safety-hook.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@typecad/cuttlefish": "1.0.0-alpha.12",
    "@typecad/hal": "1.0.0-alpha.12"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "packages/safety"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/safety",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "embedded",
    "microcontroller",
    "esp32",
    "safety",
    "functional-safety",
    "iso26262",
    "typecad",
    "cuttlefish",
    "typescript",
    "cpp",
    "firmware"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "typecad0"
}
