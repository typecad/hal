    "./ui/block-layout": {
      "types": "./dist/ui/block-layout.d.ts",
      "default": "./dist/ui/block-layout.js"
    },
    "./ir/transformers/ui-lowering": {
      "types": "./dist/ir/transformers/ui-lowering.d.ts",
      "default": "./dist/ir/transformers/ui-lowering.js"
    },
    "./ir/ui-element-auto-wire": {
      "types": "./dist/ir/ui-element-auto-wire.d.ts",
      "default": "./dist/ir/ui-element-auto-wire.js"
    },
    "./ir/transformers/ui-mount": {
      "types": "./dist/ir/transformers/ui-mount.d.ts",
      "default": "./dist/ir/transformers/ui-mount.js"
    },
    "./ir/transformers/ui-reactive": {
      "types": "./dist/ir/transformers/ui-reactive.d.ts",
      "default": "./dist/ir/transformers/ui-reactive.js"
    },
    "./ui/runtime-header": {
      "types": "./dist/ui/runtime-header.d.ts",
      "default": "./dist/ui/runtime-header.js"
    },
    "./ui/transpile-ui": {
      "types": "./dist/ui/transpile-ui.d.ts",
      "default": "./dist/ui/transpile-ui.js"
    },
    "./ui/model": {
      "types": "./dist/ui/model.d.ts",
      "default": "./dist/ui/model.js"
    },
    "./ui/ui-registry": {
      "types": "./dist/ui/ui-registry.d.ts",
      "default": "./dist/ui/ui-registry.js"
    },
    "./preview/host-gfx": {
      "types": "./dist/preview/host-gfx.d.ts",
      "default": "./dist/preview/host-gfx.js"
    },
    "./preview/host-ui-runtime": {
      "types": "./dist/preview/host-ui-runtime.d.ts",
      "default": "./dist/preview/host-ui-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "opentype.js": "^2.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@typecad/ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@typecad/ui": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@typecad/framework-native": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justind000/typecode.git",
    "directory": "packages/cuttlefish"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/cuttlefish",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "cli",
    "codegen",
    "cpp",
    "cuttlefish",
    "embedded",
    "firmware",
    "microcontroller",
    "transpiler",
    "typecad",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "typecad0"
}
