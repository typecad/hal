{
  "name": "@typecad/cuttlefish",
  "version": "0.1.0",
  "description": "TypeScript to C++ transpiler — native, Arduino, and bare-metal targets",
  "type": "module",
  "main": "./dist/transpile.js",
  "types": "./dist/transpile.d.ts",
  "bin": {
    "cuttlefish": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/transpile.d.ts",
      "default": "./dist/transpile.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./api/shared": {
      "types": "./dist/api/shared/index.d.ts",
      "default": "./dist/api/shared/index.js"
    },
    "./api/schema": {
      "types": "./dist/api/schema/index.d.ts",
      "default": "./dist/api/schema/index.js"
    },
    "./emit/route-hal-op": {
      "types": "./dist/emit/route-hal-op.d.ts",
      "default": "./dist/emit/route-hal-op.js"
    },
    "./ui/color": {
      "types": "./dist/ui/color.d.ts",
      "default": "./dist/ui/color.js"
    },
    "./ui/html-parser": {
      "types": "./dist/ui/html-parser.d.ts",
      "default": "./dist/ui/html-parser.js"
    },
    "./ui/inline-parser": {
      "types": "./dist/ui/inline-parser.d.ts",
      "default": "./dist/ui/inline-parser.js"
    },
    "./ui/rich-layout": {
      "types": "./dist/ui/rich-layout.d.ts",
      "default": "./dist/ui/rich-layout.js"
    },
    "./ui/default-keyboards": {
      "types": "./dist/ui/default-keyboards.d.ts",
      "default": "./dist/ui/default-keyboards.js"
    },
    "./ui/css-parser": {
      "types": "./dist/ui/css-parser.d.ts",
      "default": "./dist/ui/css-parser.js"
    },
    "./ui/style-resolver": {
      "types": "./dist/ui/style-resolver.d.ts",
      "default": "./dist/ui/style-resolver.js"
    },
    "./ui/layout-engine": {
      "types": "./dist/ui/layout-engine.d.ts",
      "default": "./dist/ui/layout-engine.js"
    },
    "./ui/text-layout": {
      "types": "./dist/ui/text-layout.d.ts",
      "default": "./dist/ui/text-layout.js"
    },
    "./ui/keyframes": {
      "types": "./dist/ui/keyframes.d.ts",
      "default": "./dist/ui/keyframes.js"
