// ===========================================================================
// cuttlefish board add — chip spec template
// ===========================================================================
//
// Copy this file, fill in the blanks, then run:
//
//   cuttlefish board add ./my-chip.jsonc
//
// This template uses the ESP32-C6 as the worked example — every field is
// filled with real C6 values so you can see the shape. Comments explain:
//   - what each field is
//   - WHERE to find the correct value for your chip
//   - what valid values look like
//
// The tool validates this file against a schema before generating anything,
// so a bad value fails fast with a clear error. The silicon data (pins,
// capabilities, ADC maps, unsafe flags) is the ONE input that genuinely
// requires datasheet verification — the tool never guesses it.
//
// WHERE TO VERIFY PIN DATA:
//   - Bus defaults (SDA/SCL/MOSI/MISO/SCK/SS/TX/RX) + ADC aliases (A0..An):
//     the Arduino-ESP32 core's variants/<chip>/pins_arduino.h
//     (run `arduino-cli board details -b <fqbn>` to find its path)
//   - Capabilities, strapping pins, USB pins, flash pins, warnings:
//     the chip datasheet (Espressif PDFs)
//   - FQBN: run `arduino-cli board listall | grep <chip>` to confirm
// ===========================================================================
{
  // -------------------------------------------------------------------------
  // Identity — lowercase ids drive the package names and registry entry.
  // -------------------------------------------------------------------------

  // Lowercase architecture id (e.g. "esp32c6", "esp32s3", "esp32c3").
  // Becomes the package name suffix: @typecad/mcu-<architecture>.
  // Match the chip family; the Arduino core's board-id segment is a good guide.
  "architecture": "esp32c6",

  // MCU identifier — the silicon id (e.g. "esp32-c6"). Used in the MCU def.
  "mcuId": "esp32-c6",

  // Human-readable MCU name (e.g. "ESP32-C6"). Shown in the MCU definition.
  "mcuName": "ESP32-C6",

  // Board id — lowercase (e.g. "esp32c6"). Becomes @typecad/board-<boardId>
  // and the registry entry id. Usually the same as architecture for generic
  // boards.
  "boardId": "esp32c6",

  // Human-readable board name (e.g. "ESP32-C6"). Shown in the registry.
  "boardName": "ESP32-C6",

  // Silicon vendor (e.g. "Espressif"). Shown in the board definition.
  "vendor": "Espressif",

  // Optional description of the board. Shown in the BoardDefinition.
  "description": "Generic ESP32-C6 devboard (vendor-agnostic). Single-core RISC-V (RV32IMAC) @ 160 MHz with Wi-Fi 6 (802.11ax) + BLE 5.3 and native USB Serial/JTAG + USB-OTG. 30 GPIO; no PSRAM support.",

  // -------------------------------------------------------------------------
  // Build configuration
  // -------------------------------------------------------------------------

  // Clock speed in Hz (e.g. 160000000 = 160 MHz). Check the datasheet.
  "clockSpeed": 160000000,

  // The Arduino FQBN (Fully Qualified Board Name).
  // Format: vendor:platform:board
  // CRITICAL for the ESP32 family: the Arduino core collapses the WHOLE family
  // (classic/S2/S3/C3/C6) into a single "esp32:esp32" platform. The chip
  // variant goes in the BOARD segment, NOT the platform segment.
  //   Correct:   "esp32:esp32:esp32c6"
  //   WRONG:     "esp32:esp32c6:esp32c6"  (invents a nonexistent platform)
  // VERIFY with: arduino-cli board listall | grep <chip>
  //   -> look for "ESP32C6 Dev Module    esp32:esp32:esp32c6"
  "fqbn": "esp32:esp32:esp32c6",

  // The ARDUINO_* build define for this board (e.g. "ARDUINO_ESP32C6_DEV").
  // Check the core's boards.txt for the exact define name.
  "arduinoDefine": "ARDUINO_ESP32C6_DEV",

  // -------------------------------------------------------------------------
  // Memory (module-level — the flash/RAM on the devboard module, not the die)
  // -------------------------------------------------------------------------

  // Module flash in bytes, or null if declaring only silicon memory.
  // Common: 4 MB = 4194304, 8 MB = 8388608, 16 MB = 16777216.
  "moduleFlash": 4194304,

  // External PSRAM in bytes, or null if the chip doesn't support PSRAM.
  // ESP32-S3: 2097152 (2 MB octal). ESP32-C3/C6: null (silicon doesn't support it).
  "externalRam": null,

  // -------------------------------------------------------------------------
  // GPIO range — which GPIO numbers exist on this chip's package
  // -------------------------------------------------------------------------

  // Inclusive [first, last]. The generator creates GPIO<n> constants for every
  // n in this range EXCEPT excludedGpio.
  "gpioRange": [0, 30],

  // GPIO numbers that don't exist on the package (consumed by internal flash,
  // not broken out). E.g. the ESP32-C3 omits GPIO 11 (internal flash Vpp).
  // Leave empty [] if the range is contiguous.
  "excludedGpio": [],

  // -------------------------------------------------------------------------
  // Pin data — the per-pin capability/function/warning details.
  // THIS IS THE HARDEST PART. Each entry describes one GPIO.
  // -------------------------------------------------------------------------

  // Array of pin specs. One object per GPIO in the range (skip excludedGpio).
  "pins": [
    // --- ADC1 pins (GPIO0-GPIO6 on the C6) ---
    // capabilities: one of FULL_GPIO, FULL_GPIO_ANALOG, FULL_GPIO_TOUCH,
    //               FULL_GPIO_ANALOG_TOUCH, FULL_GPIO_DAC, INPUT_ONLY.
    //   See packages/mcu-esp32s3/src/index.ts for the capability-flag meanings.
    // functions: peripheral assignments (adc, touch, spi, i2c, uart, usb, dac).
    //   { "type": "adc", "instance": 1, "role": "ch0" }  -> ADC1 channel 0
    //   { "type": "touch", "instance": 0, "role": "touch0" } -> Touch sensor 0
    //   { "type": "usb", "instance": 0, "role": "dm" } -> USB D-
    // alt: human-readable alternate-function names (shown in IDE hover/diagnostics)
    // warnings: strings shown when the pin is used as GPIO (e.g. ADC2/Wi-Fi conflict)
    // unsafe: true for strapping/USB/flash pins (users get a pin-safety warning)
    // notes: short description (e.g. "Boot strapping pin")
    { "gpio": 0, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch0"}], "alt": ["ADC1_CH0"] },
    { "gpio": 1, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch1"}], "alt": ["ADC1_CH1"] },
    { "gpio": 2, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch2"}], "alt": ["ADC1_CH2"] },
    { "gpio": 3, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch3"}], "alt": ["ADC1_CH3"] },
    { "gpio": 4, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch4"}], "alt": ["ADC1_CH4"] },
    { "gpio": 5, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch5"}], "alt": ["ADC1_CH5"] },
    { "gpio": 6, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":1,"role":"ch6"}], "alt": ["ADC1_CH6"] },

    // --- ADC2 pin (GPIO7) — Wi-Fi conflicted ---
    { "gpio": 7, "capabilities": "FULL_GPIO_ANALOG", "functions": [{"type":"adc","instance":2,"role":"ch0"}], "alt": ["ADC2_CH0"], "warnings": ["GPIO7 is ADC2 — ADC2 is unusable while Wi-Fi is enabled"] },

    { "gpio": 8, "capabilities": "FULL_GPIO", "alt": [] },

    // --- Strapping pin (unsafe) ---
    { "gpio": 9, "capabilities": "FULL_GPIO", "alt": [], "unsafe": true, "warnings": ["GPIO9 is a strapping pin — boot mode select at boot"], "notes": "Boot strapping pin" },

    { "gpio": 10, "capabilities": "FULL_GPIO", "alt": [] },
    { "gpio": 11, "capabilities": "FULL_GPIO", "alt": [] },
    { "gpio": 12, "capabilities": "FULL_GPIO", "alt": [] },

    // --- Another strapping pin (unsafe) ---
    { "gpio": 13, "capabilities": "FULL_GPIO", "alt": [], "unsafe": true, "warnings": ["GPIO13 is a strapping pin — controls VDD_SPI voltage at boot"], "notes": "Boot strapping pin" },

    { "gpio": 14, "capabilities": "FULL_GPIO", "alt": [] },
    { "gpio": 15, "capabilities": "FULL_GPIO", "alt": [] },

    // --- UART0 pins (bus defaults from pins_arduino.h: TX=16, RX=17) ---
    { "gpio": 16, "capabilities": "FULL_GPIO", "functions": [{"type":"uart","instance":0,"role":"tx"}], "alt": ["UART0 TX"], "warnings": ["Using GPIO16 as GPIO will interfere with UART0 transmit"] },
    { "gpio": 17, "capabilities": "FULL_GPIO", "functions": [{"type":"uart","instance":0,"role":"rx"}], "alt": ["UART0 RX"], "warnings": ["Using GPIO17 as GPIO will interfere with UART0 receive"] },

    // --- SPI pins (bus defaults from pins_arduino.h: SS=18, MOSI=19, MISO=20, SCK=21) ---
    { "gpio": 18, "capabilities": "FULL_GPIO", "functions": [{"type":"spi","instance":0,"role":"cs"}], "alt": ["SPI0 CS"] },
    { "gpio": 19, "capabilities": "FULL_GPIO", "functions": [{"type":"spi","instance":0,"role":"mosi"}], "alt": ["SPI0 MOSI"] },
    { "gpio": 20, "capabilities": "FULL_GPIO", "functions": [{"type":"spi","instance":0,"role":"miso"}], "alt": ["SPI0 MISO"] },
    { "gpio": 21, "capabilities": "FULL_GPIO", "functions": [{"type":"spi","instance":0,"role":"sck"}], "alt": ["SPI0 SCK"] },

    // --- I2C pins (bus defaults from pins_arduino.h: SCL=22, SDA=23) ---
    { "gpio": 22, "capabilities": "FULL_GPIO", "functions": [{"type":"i2c","instance":0,"role":"scl"}], "alt": ["I2C0 SCL"] },
    { "gpio": 23, "capabilities": "FULL_GPIO", "functions": [{"type":"i2c","instance":0,"role":"sda"}], "alt": ["I2C0 SDA"] },

    { "gpio": 24, "capabilities": "FULL_GPIO", "alt": [] },
    { "gpio": 25, "capabilities": "FULL_GPIO", "alt": [] },

    // --- USB pins (unsafe — using disables native USB) ---
    { "gpio": 26, "capabilities": "FULL_GPIO", "functions": [{"type":"usb","instance":0,"role":"dm"}], "alt": ["USB D-"], "unsafe": true, "warnings": ["GPIO26 is USB D- — using it as GPIO disables native USB"], "notes": "USB D- pin" },
    { "gpio": 27, "capabilities": "FULL_GPIO", "functions": [{"type":"usb","instance":0,"role":"dp"}], "alt": ["USB D+"], "unsafe": true, "warnings": ["GPIO27 is USB D+ — using it as GPIO disables native USB"], "notes": "USB D+ pin" },

    // --- SPI flash pins (unsafe — do not use as GPIO) ---
    { "gpio": 28, "capabilities": "FULL_GPIO", "alt": ["SPICS0"], "unsafe": true, "warnings": ["GPIO28 is connected to SPI flash — do not use as GPIO"], "notes": "SPI flash pin" },
    { "gpio": 29, "capabilities": "FULL_GPIO", "alt": ["SPICLK"], "unsafe": true, "warnings": ["GPIO29 is connected to SPI flash — do not use as GPIO"], "notes": "SPI flash pin" },
    { "gpio": 30, "capabilities": "FULL_GPIO", "alt": ["SPIQ"], "unsafe": true, "warnings": ["GPIO30 is connected to SPI flash — do not use as GPIO"], "notes": "SPI flash pin" }
  ],

  // The unsafe set — list of "GPIO<n>" names that get pin-safety warnings.
  // Should match the pins above with unsafe: true.
  "unsafe": ["GPIO9", "GPIO13", "GPIO26", "GPIO27", "GPIO28", "GPIO29", "GPIO30"],

  // Analog input pin names (ADC1 channels — usable while Wi-Fi is active).
  // These become the A0, A1, ... aliases. Omit ADC2 pins (Wi-Fi conflict).
  "analog": ["GPIO0", "GPIO1", "GPIO2", "GPIO3", "GPIO4", "GPIO5", "GPIO6"],

  // -------------------------------------------------------------------------
  // Bus default pin maps — keyed by instance number.
  // VERIFY against variants/<chip>/pins_arduino.h (the SDA/SCL/MOSI/etc defines).
  // -------------------------------------------------------------------------

  "i2c": {
    "0": { "sda": "GPIO23", "scl": "GPIO22" }
  },
  "spi": {
    "0": { "mosi": "GPIO19", "miso": "GPIO20", "sck": "GPIO21", "cs": "GPIO18" }
  },
  "uart": {
    "0": { "tx": "GPIO16", "rx": "GPIO17" }
  },

  // -------------------------------------------------------------------------
  // Peripheral instances — for the MCU peripherals block.
  // Each bus instance lists its default pins (and optional alternate pins).
  // -------------------------------------------------------------------------

  "peripheralInstances": {
    "i2c": [
      { "instance": 0, "defaultPins": { "sda": "GPIO23", "scl": "GPIO22" } }
    ],
    "spi": [
      { "instance": 0, "defaultPins": { "mosi": "GPIO19", "miso": "GPIO20", "sck": "GPIO21", "cs": "GPIO18" } }
    ],
    "uart": [
      { "instance": 0, "defaultPins": { "tx": "GPIO16", "rx": "GPIO17" } },
      { "instance": 1, "defaultPins": { "tx": "GPIO16", "rx": "GPIO17" } }
    ]
  },

  // ADC units. ADC1 (instance 0) is always usable; ADC2 (instance 1) is
  // Wi-Fi-conflicted. Channels = number of analog pins on that unit.
  "adc": [
    { "instance": 0, "channels": 7, "resolution": 12, "referenceVoltage": 3.3, "maxValue": 4095, "referenceVoltages": { "DEFAULT": 3.3, "INTERNAL": 1.1 } },
    { "instance": 1, "channels": 1, "resolution": 12, "referenceVoltage": 3.3, "maxValue": 4095, "referenceVoltages": { "DEFAULT": 3.3, "INTERNAL": 1.1 } }
  ],

  // PWM (LEDC) capabilities. channels = LEDC channel count; resolution in bits.
  "pwm": { "channels": 6, "resolution": 14, "maxFrequency": 40000000 },

  // Touch peripheral. null if the chip has no usable touch (e.g. ESP32-C6 —
  // its touch peripheral is non-standard and not exposed by the Arduino core).
  // For chips with touch (ESP32, ESP32-S3, ESP32-C3): { channels, pins }.
  "touch": null,

  // Hardware timers. bits must be one of 8, 16, 32, 64 (schema constraint —
  // use 64 even if the hardware is 52-bit, as on most ESP32 variants).
  "timers": [
    { "instance": 0, "type": "general", "bits": 64, "features": ["interrupt"] },
    { "instance": 1, "type": "general", "bits": 64, "features": ["interrupt"] },
    { "instance": 2, "type": "general", "bits": 64, "features": ["interrupt"] },
    { "instance": 3, "type": "general", "bits": 64, "features": ["interrupt"] }
  ],

  // -------------------------------------------------------------------------
  // Connectivity
  // -------------------------------------------------------------------------

  // Wi-Fi. type: "wifi" (802.11 b/g/n) or "wifi6" (802.11ax — ESP32-C6 only).
  "wifi": { "type": "wifi6", "supportsStation": true, "supportsAp": true },

  // Bluetooth. type: "ble", "classic", or "dual". version e.g. "5.0", "5.3".
  "bluetooth": { "type": "ble", "version": "5.3" },

  // USB. type: "device", "host", or "otg". vid/pid are the USB identifiers
  // (Espressif's assigned VID is 0x303A).
  "usb": { "type": "otg", "vid": "0x303A", "pid": "0x0001" },

  // -------------------------------------------------------------------------
  // Feature flags — silicon capabilities
  // -------------------------------------------------------------------------

  // multicore/coreCount: count only cores programmable via the Arduino API.
  //   ESP32/S3: multicore true, coreCount 2. ESP32-C3/C6: false, 1 (the LP
  //   coprocessor on the C6 is NOT counted — it can't run Arduino code).
  // fpu: true for Xtensa (S3), false for RISC-V (C3/C6 lack the F extension).
  "features": { "multicore": false, "coreCount": 1, "deepSleep": true, "watchdog": true, "externalInterrupts": true, "hardwareRng": true, "fpu": false },

  // -------------------------------------------------------------------------
  // Silicon memory (intrinsic to the die — distinct from moduleFlash above)
  // -------------------------------------------------------------------------

  // flash = usable app flash (total minus bootloader/OTADATA reservation).
  // sram = on-die SRAM. eeprom = 0 for ESP32 (no hardware EEPROM).
  // rtcMemory = RTC slow memory. externalRam = null or omit if no PSRAM.
  "memory": { "flash": 393216, "sram": 524288, "eeprom": 0, "rtcMemory": 16384 }
}
