{
  "name": "@typecad/framework-avr",
  "version": "1.0.0-alpha.6",
  "description": "TypeCAD framework package for native AVR register-level code generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./framework.manifest": {
      "types": "./framework.manifest.ts",
      "default": "./dist/framework.manifest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test:hw": "npm exec -- cuttlefish-test",
    "test:hw:basics": "npm exec -- cuttlefish-test tests/01-basics.test.ts",
    "test:hw:timers": "npm exec -- cuttlefish-test tests/42-timers.test.ts"
  },
  "dependencies": {
    "@typecad/cuttlefish": "1.0.0-alpha.6",
    "@typecad/framework-arduino": "1.0.0-alpha.6"
  },
  "devDependencies": {
    "@typecad/expect": "1.0.0-alpha.6",
    "@typecad/board-arduino-uno": "1.0.0-alpha.6"
  },
  "license": "MIT"
}
