{
  "name": "@typecad/framework-avr",
  "version": "0.1.0-alpha.2",
  "description": "TypeCAD framework package for native AVR register-level code generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test:hw": "npm exec -- cuttlefish-test",
    "test:hw:basics": "npm exec -- cuttlefish-test tests/01-basics.test.ts"
  },
  "dependencies": {
    "@typecad/cuttlefish": "0.1.0-alpha.2",
    "@typecad/framework-arduino": "0.1.0-alpha.2"
  },
  "devDependencies": {
    "@typecad/expect": "0.1.0-alpha.2",
    "@typecad/board-arduino-uno": "0.1.0-alpha.2"
  },
  "license": "MIT"
}
