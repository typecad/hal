{
  "name": "@typehal/framework-arduino",
  "version": "0.1.0",
  "description": "TypeHAL framework package for Arduino framework code generation",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arduino": {
      "types": "./dist/arduino/index.d.ts",
      "default": "./dist/arduino/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test:hw": "npm exec -- typehal-test",
    "test:hw:single": "npm exec -- typehal-test"
  },
  "dependencies": {
    "@typehal/core": "*",
    "@typehal/expect": "*",
    "@typehal/board-esp32-devkit": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}