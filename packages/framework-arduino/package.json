{
  "name": "@typecad/framework-arduino",
  "version": "1.0.0-alpha.14",
  "description": "TypeCAD framework package for Arduino framework code generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arduino": {
      "types": "./dist/arduino/index.d.ts",
      "default": "./dist/arduino/index.js"
    },
    "./graphics/ili9341": {
      "types": "./dist/graphics/ili9341.d.ts",
      "default": "./dist/graphics/ili9341.js"
    },
    "./displays/ili9341-spi": {
      "types": "./dist/displays/ili9341-spi.d.ts",
      "default": "./dist/displays/ili9341-spi.js"
    },
    "./framework.manifest": {
      "types": "./dist/framework.manifest.d.ts",
      "default": "./dist/framework.manifest.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run --root ../.. tests/packages/framework-arduino/manifest.test.ts",
    "test:coverage": "npm test && tsx ../../scripts/render-framework-coverage.ts"
  },
  "dependencies": {
    "@typecad/cuttlefish": "1.0.0-alpha.14",
    "@typecad/hal": "1.0.0-alpha.14",
    "@typecad/arduino-cli": "1.0.0-alpha.14"
  },
  "devDependencies": {
    "@typecad/expect": "1.0.0-alpha.14",
    "@typecad/board-esp32-devkit": "1.0.0-alpha.14"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justind000/typecode.git",
    "directory": "packages/framework-arduino"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/framework-arduino",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "cpp",
    "cuttlefish",
    "embedded",
    "esp32",
    "firmware",
    "framework",
    "microcontroller",
    "typecad",
    "typescript"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "author": "typecad0",
  "sideEffects": false
}
