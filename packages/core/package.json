{
  "name": "@typehal/core",
  "version": "0.1.0",
  "description": "TypeHAL core types and interfaces for embedded development",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arduino": {
      "types": "./dist/arduino/index.d.ts",
      "default": "./dist/arduino/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}