{
  "name": "@typecad/framework-native",
  "version": "0.1.0",
  "description": "TypeCAD framework package for native C++ code generation (Windows/Linux executables)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graphics/terminal-preview": {
      "types": "./dist/graphics/terminal-preview.d.ts",
      "default": "./dist/graphics/terminal-preview.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@typecad/cuttlefish": "*"
  },
  "devDependencies": {
    "@typecad/expect": "*",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justind000/typecode.git",
    "directory": "packages/framework-native"
  },
  "homepage": "https://github.com/justind000/typecode/tree/main/packages/framework-native",
  "bugs": {
    "url": "https://github.com/justind000/typecode/issues"
  },
  "keywords": [
    "arduino",
    "cpp",
    "cuttlefish",
    "desktop",
    "embedded",
    "firmware",
    "framework",
    "linux",
    "microcontroller",
    "native",
    "typecad",
    "typescript",
    "windows"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "typecad0"
}
