{
  "name": "typecad-monorepo",
  "private": true,
  "workspaces": [
    "packages/cuttlefish",
    "packages/hal",
    "packages/mcu-atmega328p",
    "packages/mcu-esp32",
    "packages/framework-avr",
    "packages/framework-arduino",
    "packages/framework-native",
    "packages/board-arduino-uno",
    "packages/board-esp32-devkit",
    "packages/expect",
    "packages/simulator",
    "demo",
    "native_demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -b",
    "ci": "npm test && npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hw": "npm run test:hw --workspace @typecad/framework-arduino",
    "test:hw:basics": "npm run test:hw:basics --workspace @typecad/framework-arduino",
    "publish:cuttlefish": "npm publish --workspace @typecad/cuttlefish --access public",
    "publish:hal": "npm publish --workspace @typecad/hal --access public",
    "publish:expect": "npm publish --workspace @typecad/expect --access public",
    "publish:all": "npm run publish:cuttlefish && npm run publish:hal && npm run publish:expect",
    "publish:private": "npm run publish:cuttlefish -- --registry http://192.168.2.207:4873/ && npm run publish:hal -- --registry http://192.168.2.207:4873/ && npm run publish:expect -- --registry http://192.168.2.207:4873/",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "vitest": "^4.0.18"
  }
}
