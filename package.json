{
  "name": "typecad-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/cuttlefish",
    "packages/hal",
    "packages/mcu-atmega328p",
    "packages/mcu-esp32",
    "packages/mcu-esp32s3",
    "packages/mcu-esp32c3",
    "packages/mcu-esp32c6",    "packages/framework-avr",
    "packages/framework-arduino",
    "packages/framework-native",
    "packages/board-arduino-uno",
    "packages/board-esp32-devkit",
    "packages/board-esp32s3",
    "packages/board-esp32c3",
    "packages/board-esp32c6",
    "packages/expect",
    "packages/ui",
    "packages/simulator",
    "demo",
    "demo-ui",
    "demo-ui-sd13",
    "demo-weather",
    "native_demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -b",
    "ci": "npm test && npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui-layout": "vitest run tests/packages/cuttlefish/ui-layout-harness.test.ts",
    "test:hw": "npm run test:hw --workspace @typecad/framework-arduino",
    "test:hw:basics": "npm run test:hw:basics --workspace @typecad/framework-arduino",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/css-tree": "^2.3.11",
    "css-tree": "^3.2.1",
    "linkedom": "^0.18.12",
    "puppeteer": "^25.1.0",
    "vitest": "^4.0.18",
    "yoga-layout": "^3.2.1"
  }
}
