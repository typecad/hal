{
  "name": "vscode-typehal-debug",
  "displayName": "TypeHAL Debug",
  "description": "Breakpoint debugging for TypeHAL embedded projects",
  "version": "0.1.0",
  "private": true,
  "publisher": "typehal",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "workspaceContains:**/typehal.config.ts"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "typehal-debug.toggleBreakpoint",
        "title": "TypeHAL: Toggle Breakpoint"
      },
      {
        "command": "typehal-debug.clearAllBreakpoints",
        "title": "TypeHAL: Clear All Breakpoints"
      },
      {
        "command": "typehal-debug.debugWithBreakpoints",
        "title": "TypeHAL: Debug with Breakpoints"
      },
      {
        "command": "typehal-debug.syncBreakpoints",
        "title": "TypeHAL: Sync Breakpoints from VS Code"
      }
    ],
    "keybindings": [
      {
        "command": "typehal-debug.toggleBreakpoint",
        "key": "f9",
        "when": "editorTextFocus && resourceExtname == .ts"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "typehal-debug.toggleBreakpoint",
          "group": "debug",
          "when": "resourceExtname == .ts"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.3"
  }
}