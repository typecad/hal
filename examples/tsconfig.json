      "@typehal/board-arduino-uno":             ["../packages/board-arduino-uno/src/index.ts"],
      "@typehal/board-esp32-devkit":            ["../packages/board-esp32-devkit/src/index.ts"],
      "@typehal/framework-arduino":             ["../packages/framework-arduino/src/index.ts"],
      "@typehal/simulator":                     ["../packages/simulator/src/index.ts"],
      "@typehal/expect":                        ["../packages/expect/src/index.ts"],
      "@typehal/transpiler":                    ["../packages/transpiler/src/transpile.ts"],
      "@typehal/transpiler/testing":            ["../packages/transpiler/src/testing.ts"]
