{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "node16",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "paths": {
      "@typecad":                               ["../boards/board-arduino-uno/src/index.ts"],
      "@typecad/hal":                           ["../packages/hal/src/index.ts"],
      "@typecad/board":                         ["../packages/cuttlefish/src/api/index.ts"],
      "@typecad/cuttlefish/api/schema":                        ["../packages/cuttlefish/src/api/schema/index.ts"],
      "@typecad/board-arduino-uno":             ["../boards/board-arduino-uno/src/index.ts"],
      "@typecad/board-esp32-devkit":            ["../boards/board-esp32-devkit/src/index.ts"],
      "@typecad/framework-arduino":             ["../packages/framework-arduino/src/index.ts"],
      "@typecad/simulator":                     ["../packages/simulator/src/index.ts"],
      "@typecad/expect":                        ["../packages/expect/src/index.ts"],
      "@typecad/cuttlefish":                    ["../packages/cuttlefish/src/transpile.ts"],
      "@typecad/cuttlefish/testing":            ["../packages/cuttlefish/src/testing.ts"]
    }
  },
  "include": ["*.ts", "*.d.ts"]
}
